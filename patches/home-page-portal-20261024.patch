+#: A stand-in for the Home Page project's homepage package: it lists the apps it is handed and serves them.
+FAKE_HOME_PAGE = """
+API = 1
+import html
+
+
+class App:
+    def __init__(self, key, mount, app, name, subtitle="", description="", preview=None, disallow=(), legacy=None):
+        self.key, self.mount, self.app, self.name, self.subtitle = key, mount, app, name, subtitle
+        self.preview, self.disallow, self.legacy = preview, disallow, legacy
+
+
+def build(apps=(), allowed_hosts=None, visitor_hosts=None, config=None):
+    def portal(environ, start_response):
+        path, host = environ["PATH_INFO"], environ.get("HTTP_HOST", "")
+        for item in apps:
+            if path.startswith(item.mount + "/"):
+                environ = dict(environ, SCRIPT_NAME=item.mount, PATH_INFO=path[len(item.mount):])
+                return item.app(environ, start_response)
+        if not allowed_hosts(host):
+            start_response("400 Bad Request", [])
+            return [b""]
+        rows = "".join(f'<a href="{item.mount}/">{html.escape(item.name)}</a> {item.subtitle} {item.disallow} {item.legacy} '
+                       + "".join(f'<a href="{item.mount}{p}">{html.escape(t)}</a>' for t, p in item.preview()["items"])
+                       for item in apps)
+        body = f"{rows} visitor={visitor_hosts(host)} scheme={environ['wsgi.url_scheme']}".encode()
+        start_response("200 OK", [("Content-Type", "text/html; charset=utf-8")])
+        return [body]
+    return portal
+"""
+
+
