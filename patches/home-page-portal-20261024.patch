+def home_page_dir() -> Path:
+    """The Home Page project's folder (``HOME_PAGE_DIR`` overrides)."""
+    return Path(os.environ.get("HOME_PAGE_DIR") or Path.home() / "Documents" / "Claude" / "Home Page")
+
+
+def _code_stamp(folder: Path) -> tuple:
+    """What the Home Page code is now: its files' names, sizes and times ((): not there)."""
+    package = folder / "homepage"
+    try:
+        return tuple(sorted((str(file.relative_to(package)), file.stat().st_mtime_ns, file.stat().st_size)
+                            for file in package.rglob("*.py") if "__pycache__" not in file.parts))
+    except OSError:
+        return ()
+
+
+#: The Home Page code the last build used, to see when it changed.
+_built_from: tuple[Path, tuple] | None = None
+
+
+def code_changed() -> bool:
+    """Whether the Home Page code differs from what the last ``build`` loaded (it came, went, or was edited)."""
+    if _built_from is None:
+        return False
+    folder, stamp = _built_from
+    return home_page_dir() != folder or _code_stamp(folder) != stamp
+
+
+def _load_home_page(folder: Path):
+    """The ``homepage`` package from ``folder``, or None (not there, broken, or another contract)."""
+    init = folder / "homepage" / "__init__.py"
+    if not init.is_file():
+        return None
+    try:
+        spec = importlib.util.spec_from_file_location("homepage", init, submodule_search_locations=[str(init.parent)])
+        module = importlib.util.module_from_spec(spec)
+        sys.modules["homepage"] = module
+        spec.loader.exec_module(module)
+    except Exception as exc:  # noqa: BLE001 - a broken Home Page never keeps News Site down
+        sys.modules.pop("homepage", None)
+        print(f"サイト一覧（{folder}）を読み込めませんでした: {exc!r}。News Site だけを配信します。", flush=True)
+        return None
+    if getattr(module, "API", None) != HOME_PAGE_API:
+        print(f"サイト一覧（{folder}）の版が合いません（API {getattr(module, 'API', None)}）。News Site だけを配信します。", flush=True)
+        return None
+    return module
+
