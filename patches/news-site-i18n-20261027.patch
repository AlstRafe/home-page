+                        "元": "人民幣", "ルピー": "盧比", "ルーブル": "盧布", "ディナール": "第納爾", "ペソ": "披索", "レアル": "雷亞爾",
+                        "シェケル": "謝克爾", "バーツ": "泰銖", "ルピア": "印尼盾", "フラン": "法郎", "フリヴニャ": "格里夫納",
+                        "リンギット": "令吉"}},
